---
import { Icon } from '@/components/user'
import { getVaultGraphData } from '@/utils/graph'

interface Props {
  localSlug?: string
  width?: number | string
  height?: number | string
  class?: string
  modalOnly?: boolean
}

const {
  localSlug,
  width = '100%',
  height = '250px',
  class: className,
  modalOnly = false
} = Astro.props
const allData = modalOnly
  ? { nodes: [], links: [], linksMap: {}, backlinksMap: {} }
  : await getVaultGraphData()

let localData = { nodes: allData.nodes, links: allData.links }

if (localSlug) {
  // Build neighborhood
  const neighbors = new Set<string>()
  neighbors.add(localSlug)

  if (allData.linksMap[localSlug]) {
    allData.linksMap[localSlug].forEach((n) => neighbors.add(n))
  }
  if (allData.backlinksMap[localSlug]) {
    allData.backlinksMap[localSlug].forEach((n) => neighbors.add(n))
  }

  const localNodes = allData.nodes.filter((n) => neighbors.has(n.id))
  // only keep links between neighbors
  const localLinks = allData.links.filter((l) => neighbors.has(l.source) && neighbors.has(l.target))

  localData = { nodes: localNodes, links: localLinks }
}
---

<div
  class={`flex flex-col ${className || ''}`}
  id={`vault-graph-component-${localSlug || 'global'}`}
>
  <!-- Iris-style Header / Trigger Button -->
  {
    modalOnly ? (
      <button
        type='button'
        class='global-graph-btn flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-border bg-muted/30 text-muted-foreground hover:text-foreground hover:bg-muted transition-colors cursor-pointer text-sm font-medium'
        title='Open Global Graph'
        aria-label='Open Global Graph'
      >
        <svg
          class='size-4.5'
          xmlns='http://www.w3.org/2000/svg'
          width='1em'
          height='1em'
          viewBox='0 0 24 24'
        >
          <path
            fill='none'
            stroke='currentColor'
            stroke-linecap='round'
            stroke-linejoin='round'
            stroke-miterlimit='10'
            d='M13.5 13.25L10 15.5l-3.5-2.25v-3.5L10 7.5l3.5 2.25zm-9-6.5L2.5 8l-2-1.25v-2l2-1.25l2 1.25zm15-2L17.5 6l-2-1.25v-2l2-1.25l2 1.25zm-15 16.5l-2 1.25l-2-1.25v-2l2-1.25l2 1.25zm16.5 1l-2 1.25l-2-1.25v-2L19 19l2 1.25zm1.5-9.75l-2 1.25l-2-1.25v-2l2-1.25l2 1.25zm-16-2.75L3.813 7.18m13.883 12.635l-5.968-5.426M18.5 11.5h-5m-5.548 2.684l-4.27 4.555M16.318 5.261l-3.686 3.931'
          />
        </svg>
        Open Graph
      </button>
    ) : localSlug ? (
      <details class='group' open>
        <summary class='font-medium py-2 flex items-center justify-between text-muted-foreground uppercase text-xs tracking-wider cursor-pointer list-none select-none hover:text-foreground'>
          <span class='flex items-center gap-2'>GRAPH</span>
          <div class='flex items-center gap-2'>
            <slot name='controls'>
              <button
                class='global-graph-btn text-muted-foreground hover:text-foreground transition-colors p-0.5 rounded-sm cursor-pointer'
                title='Global Graph'
                aria-label='Open Global Graph'
              >
                <svg
                  class='size-4'
                  xmlns='http://www.w3.org/2000/svg'
                  width='1em'
                  height='1em'
                  viewBox='0 0 24 24'
                >
                  <path
                    fill='none'
                    stroke='currentColor'
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    stroke-miterlimit='10'
                    d='M13.5 13.25L10 15.5l-3.5-2.25v-3.5L10 7.5l3.5 2.25zm-9-6.5L2.5 8l-2-1.25v-2l2-1.25l2 1.25zm15-2L17.5 6l-2-1.25v-2l2-1.25l2 1.25zm-15 16.5l-2 1.25l-2-1.25v-2l2-1.25l2 1.25zm16.5 1l-2 1.25l-2-1.25v-2L19 19l2 1.25zm1.5-9.75l-2 1.25l-2-1.25v-2l2-1.25l2 1.25zm-16-2.75L3.813 7.18m13.883 12.635l-5.968-5.426M18.5 11.5h-5m-5.548 2.684l-4.27 4.555M16.318 5.261l-3.686 3.931'
                  />
                </svg>
              </button>
            </slot>
            <Icon
              name='chevron-down'
              class='size-4 transition-transform duration-200 group-open:rotate-180'
            />
          </div>
        </summary>
        <div
          class='relative overflow-hidden rounded-lg border border-border/70 bg-transparent'
          style={{
            height: typeof height === 'number' ? `${height}px` : height,
            width: typeof width === 'number' ? `${width}px` : width
          }}
        >
          <div
            class='vault-graph w-full h-full'
            data-graph={JSON.stringify(localData)}
            data-local={localSlug || ''}
          />
        </div>
      </details>
    ) : (
      <div
        class='relative overflow-hidden rounded-lg border border-border/70 bg-transparent'
        style={{
          height: typeof height === 'number' ? `${height}px` : height,
          width: typeof width === 'number' ? `${width}px` : width
        }}
      >
        <div
          class='vault-graph w-full h-full'
          data-graph={JSON.stringify(localData)}
          data-local={localSlug || ''}
        />
      </div>
    )
  }

  <!-- Global Graph Overlay Modal -->
  {
    (localSlug || modalOnly) && (
      <dialog class='vault-global-graph-modal fixed inset-0 z-[100] m-0 h-[100dvh] max-h-screen w-screen border-none bg-background p-0 text-foreground opacity-0 pointer-events-none transition-opacity duration-300'>
        <div class='w-full h-full flex flex-col p-4 md:p-8'>
          <div class='flex items-center justify-between mb-4 z-10 flex-shrink-0'>
            <h2 class='font-medium text-muted-foreground uppercase tracking-widest text-sm flex items-center gap-2'>
              <svg
                class='size-5'
                xmlns='http://www.w3.org/2000/svg'
                width='1em'
                height='1em'
                viewBox='0 0 24 24'
              >
                <path
                  fill='none'
                  stroke='currentColor'
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  stroke-miterlimit='10'
                  d='M13.5 13.25L10 15.5l-3.5-2.25v-3.5L10 7.5l3.5 2.25zm-9-6.5L2.5 8l-2-1.25v-2l2-1.25l2 1.25zm15-2L17.5 6l-2-1.25v-2l2-1.25l2 1.25zm-15 16.5l-2 1.25l-2-1.25v-2l2-1.25l2 1.25zm16.5 1l-2 1.25l-2-1.25v-2L19 19l2 1.25zm1.5-9.75l-2 1.25l-2-1.25v-2l2-1.25l2 1.25zm-16-2.75L3.813 7.18m13.883 12.635l-5.968-5.426M18.5 11.5h-5m-5.548 2.684l-4.27 4.555M16.318 5.261l-3.686 3.931'
                />
              </svg>
              VAULT GRAPH
            </h2>
            <button
              class='close-global-graph hover:bg-muted p-2 rounded-full cursor-pointer transition-colors'
              aria-label='Close Global Graph'
            >
              <svg
                xmlns='http://www.w3.org/2000/svg'
                width='20'
                height='20'
                viewBox='0 0 24 24'
                fill='none'
                stroke='currentColor'
                stroke-width='2'
                stroke-linecap='round'
                stroke-linejoin='round'
              >
                <line x1='18' y1='6' x2='6' y2='18' />
                <line x1='6' y1='6' x2='18' y2='18' />
              </svg>
            </button>
          </div>
          <div class='relative flex-1 w-full overflow-hidden rounded-xl border border-border bg-card'>
            <div class='vault-graph w-full h-full' data-global='true' />
            <div class='absolute top-3 right-3 z-10 flex items-center gap-1 select-none'>
              <span class='graph-stats mr-1 text-xs text-muted-foreground/80 whitespace-nowrap' />
              <button
                class='size-7 rounded-md border border-border bg-card/90 text-sm text-muted-foreground hover:bg-muted hover:text-foreground transition-colors cursor-pointer'
                data-graph-action='zoom-out'
                aria-label='Zoom out'
                title='Zoom out'
              >
                −
              </button>
              <button
                class='size-7 rounded-md border border-border bg-card/90 text-sm text-muted-foreground hover:bg-muted hover:text-foreground transition-colors cursor-pointer'
                data-graph-action='zoom-in'
                aria-label='Zoom in'
                title='Zoom in'
              >
                +
              </button>
              <button
                class='size-7 rounded-md border border-border bg-card/90 text-sm text-muted-foreground hover:bg-muted hover:text-foreground transition-colors cursor-pointer'
                data-graph-action='fit'
                aria-label='Fit to view'
                title='Fit to view'
              >
                ⤢
              </button>
            </div>
          </div>
        </div>
      </dialog>
    )
  }
</div>

<script>
  import ForceGraph from 'force-graph'

  function createGraph(container: any, gData: any, localSlug: string) {
    const wrapper = container.parentElement
    if (!wrapper) return null

    const style = getComputedStyle(document.body)
    const parseHsl = (varName: string, alpha = 1) => {
      const val = style.getPropertyValue(varName).trim()
      if (!val) return `rgba(150, 150, 150, ${alpha})`
      return `hsl(${val} / ${alpha})`
    }

    const primary = parseHsl('--primary')
    const isGlobal = !localSlug

    let hoverNode: any = null
    let hoverNeighbors = new Set<string>()
    const neighborMap = new Map<string, Set<string>>()

    gData.links.forEach((link: any) => {
      const source = link.source.id ?? link.source
      const target = link.target.id ?? link.target
      neighborMap.set(source, (neighborMap.get(source) ?? new Set()).add(target))
      neighborMap.set(target, (neighborMap.get(target) ?? new Set()).add(source))
    })

    // @ts-ignore
    const ForceGraphFn = (ForceGraph.default || ForceGraph) as any
    const Graph = ForceGraphFn()

    const rMultiplier = isGlobal ? 3.5 : 2.5
    const rBase = isGlobal ? 5 : 4
    // Match the pointer-hit radius to the drawn radius so hover feels accurate.
    Graph.nodeRelSize(rMultiplier)

    Graph(container)
      .graphData(gData)
      .width(wrapper.offsetWidth)
      .height(wrapper.offsetHeight)
      .nodeId('id')
      .nodeLabel('name')
      .nodeVal('val')
      .onNodeHover((node: any) => {
        hoverNode = node
        hoverNeighbors = node
          ? new Set([node.id, ...(neighborMap.get(node.id) ?? [])])
          : new Set<string>()
      })
      .linkColor((link: any) => {
        if (hoverNode) {
          const s = link.source.id ?? link.source
          const t = link.target.id ?? link.target
          const connected = s === hoverNode.id || t === hoverNode.id
          return connected
            ? parseHsl('--muted-foreground', 0.7)
            : parseHsl('--muted-foreground', 0.08)
        }
        return parseHsl('--muted-foreground', 0.3)
      })
      .linkWidth((link: any) => {
        if (hoverNode) {
          const s = link.source.id ?? link.source
          const t = link.target.id ?? link.target
          return s === hoverNode.id || t === hoverNode.id ? 1.8 : 0.8
        }
        return 1
      })
      .linkDirectionalArrowLength(3.5)
      .linkDirectionalArrowRelPos(1)
      .nodeCanvasObject((node: any, ctx: any, globalScale: any) => {
        const isNeighbor = hoverNeighbors.has(node.id)
        const isHovered = hoverNode === node
        const isActive = localSlug && node.id === localSlug

        let alpha = 1
        if (hoverNode && !isNeighbor && !isHovered) {
          alpha = 0.15
        }

        const r = Math.max(rBase, Math.sqrt(node.val) * rMultiplier)

        ctx.beginPath()
        ctx.arc(node.x, node.y, r, 0, 2 * Math.PI, false)

        if (isActive) {
          ctx.fillStyle = primary
        } else if (isHovered || isNeighbor) {
          ctx.fillStyle = parseHsl('--primary', 0.2 * alpha)
        } else {
          ctx.fillStyle = parseHsl('--muted-foreground', 0.4 * alpha)
        }
        ctx.fill()

        ctx.lineWidth = isActive || isHovered ? 2 : 1
        if (isActive) {
          ctx.strokeStyle = primary
        } else if (isHovered || isNeighbor) {
          ctx.strokeStyle = parseHsl('--primary', 0.7 * alpha)
        } else {
          ctx.strokeStyle = parseHsl('--border', alpha * 0.9)
        }
        ctx.stroke()

        // Local graphs are note context maps, so their node names stay visible.
        const labelThreshold = isGlobal ? 0.4 : 1.2
        const showLabel =
          !isGlobal ||
          isActive ||
          isHovered ||
          (hoverNode && isNeighbor) ||
          globalScale > labelThreshold
        if (showLabel) {
          const label = node.name
          const fontSize = 10 / globalScale
          ctx.font = `${fontSize}px "Satoshi", sans-serif`
          ctx.textAlign = 'center'
          ctx.textBaseline = 'top'
          ctx.fillStyle = isActive ? primary : parseHsl('--foreground', alpha * 0.85)
          ctx.fillText(label, node.x, node.y + r + 3)
        }
      })
      .onNodeClick((node: any) => {
        window.location.href = `/vault/${node.id}`
      })

    // @ts-ignore
    Graph.d3Force('charge')
      .strength(isGlobal ? -520 : -180)
      .distanceMax(isGlobal ? 900 : 250)
    // @ts-ignore
    Graph.d3Force('link').distance(isGlobal ? 90 : 40)
    // @ts-ignore
    Graph.d3Force('center').strength(isGlobal ? 0.08 : 0.4)
    Graph.d3VelocityDecay(isGlobal ? 0.42 : 0.4)
      .warmupTicks(isGlobal ? 180 : 40)
      .cooldownTicks(isGlobal ? 300 : 120)

    const resizeObserver = new ResizeObserver(() => {
      if (wrapper.offsetWidth > 0 && wrapper.offsetHeight > 0) {
        Graph.width(wrapper.offsetWidth)
        Graph.height(wrapper.offsetHeight)
      }
    })
    resizeObserver.observe(wrapper)

    document.addEventListener(
      'astro:before-swap',
      () => {
        resizeObserver.disconnect()
        // @ts-ignore
        if (Graph._destructor) Graph._destructor()
        // @ts-ignore
        else if (Graph.pauseAnimation) Graph.pauseAnimation()
      },
      { once: true }
    )

    return Graph
  }

  function initGraphs() {
    // 1. Initialize inline standard graphs
    const inlineContainers = document.querySelectorAll('.vault-graph:not([data-global="true"])')
    inlineContainers.forEach((container) => {
      // @ts-ignore
      if (container.dataset.rendered === 'true') return
      // @ts-ignore
      container.dataset.rendered = 'true'
      // @ts-ignore
      const rawData = container.dataset.graph
      if (!rawData) return
      const gData = JSON.parse(rawData)
      // @ts-ignore
      createGraph(container, gData, container.dataset.local || '')
    })

    // 2. Map Dialog Toggles
    const components = document.querySelectorAll('[id^="vault-graph-component-"]')
    components.forEach((comp) => {
      // @ts-ignore
      if (comp.dataset.modalSetup === 'true') return
      // @ts-ignore
      comp.dataset.modalSetup = 'true'

      const btn = comp.querySelector('.global-graph-btn')
      const modal = comp.querySelector('.vault-global-graph-modal')
      const closeBtn = comp.querySelector('.close-global-graph')
      const globalGraphContainer = comp.querySelector('.vault-graph[data-global="true"]')

      if (btn && modal && globalGraphContainer) {
        let globalGraphInstance: any = null

        const openModal = () => {
          // @ts-ignore
          modal.showModal()
          modal.classList.remove('opacity-0', 'pointer-events-none')
          document.body.style.overflow = 'hidden'

          if (!globalGraphInstance) {
            // Lazily fetch global graph data on first open to avoid embedding it in every page
            setTimeout(async () => {
              try {
                const response = await fetch('/vault/graph.json')
                const gData = await response.json()
                globalGraphInstance = createGraph(globalGraphContainer, gData, '')
                if (globalGraphInstance) {
                  const statsEl = comp.querySelector('.graph-stats')
                  if (statsEl) {
                    statsEl.textContent = `${gData.nodes.length} notes · ${gData.links.length} links`
                  }
                  // Give the canvas a beat to render before fitting
                  setTimeout(() => {
                    // @ts-ignore
                    globalGraphInstance.zoomToFit(400, 32)
                  }, 120)
                }
              } catch (err) {
                console.error(
                  'Failed to load global graph data. Please refresh the page or check your network connection.',
                  err
                )
              }
            }, 10)
          } else {
            // Re-fit every time the modal opens
            setTimeout(() => {
              // @ts-ignore
              globalGraphInstance.zoomToFit(400, 32)
            }, 120)
          }
        }

        btn.addEventListener('click', (e) => {
          e.preventDefault()
          e.stopPropagation()
          openModal()
        })

        // Zoom controls inside the modal
        const controlBtns = comp.querySelectorAll('[data-graph-action]')
        controlBtns.forEach((cb) => {
          cb.addEventListener('click', () => {
            if (!globalGraphInstance) return
            // @ts-ignore
            const action = cb.dataset.graphAction
            // @ts-ignore
            const currentZoom = globalGraphInstance.zoom()
            if (action === 'zoom-in') {
              // @ts-ignore
              globalGraphInstance.zoom(Math.min(8, currentZoom * 1.4), 300)
            } else if (action === 'zoom-out') {
              // @ts-ignore
              globalGraphInstance.zoom(Math.max(0.2, currentZoom / 1.4), 300)
            } else if (action === 'fit') {
              // @ts-ignore
              globalGraphInstance.zoomToFit(400, 32)
            }
          })
        })

        const closeModal = () => {
          modal.classList.add('opacity-0', 'pointer-events-none')
          document.body.style.overflow = ''
          setTimeout(() => {
            // @ts-ignore
            modal.close()
          }, 300)
        }

        if (closeBtn) closeBtn.addEventListener('click', closeModal)

        modal.addEventListener('close', () => {
          modal.classList.add('opacity-0', 'pointer-events-none')
          document.body.style.overflow = ''
        })

        modal.addEventListener('click', (e) => {
          if (e.target === modal) {
            closeModal()
          }
        })
      }
    })
  }

  document.addEventListener('astro:page-load', initGraphs)
  initGraphs()
</script>
